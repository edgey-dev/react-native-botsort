{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["botsort"],
  "ios": {
    "iosModuleName": "NitroBotsort"
  },
  "android": {
    "androidNamespace": ["botsort"],
    "androidCxxLibName": "NitroBotsort"
  },
  "autolinking": {
    "BoTSortTracker": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridBoTSortTracker"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
